---
interface Props {
	title: string
	class: string
}

const { title, class: className } = Astro.props
---

<div class="flex flex-row py-6">
	<div class="flex flex-1">
		<div class={`${className} -rotate-3 -skew-x-3 flex-1 -mr-1`}></div>
		<div class={`${className} -mr-1 rotate-3 skew-x-3 flex flex-col justify-center`}>
			<h2 class="text-primary max-xs:text-2xl px-6 py-4 text-3xl font-black uppercase">
				{title}
			</h2>
		</div>
		<div class={`${className} hidden max-xl:block -rotate-3 -skew-x-3 flex-1 -mr-1`}></div>
	</div>
	<div class="flex-1 max-xl:hidden"></div>
</div>
<div class="flex flex-col pt-2 pb-12">
	<slot />
</div>
