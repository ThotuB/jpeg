---
interface Props {
	letter: string
	vals: number[]
	transposed?: boolean
}

const { letter, vals, transposed } = Astro.props
---

<div
	class={` flex ${
		transposed ? 'flex-row' : 'flex-col'
	} border-2 border-secondary rounded-2xl text-4xl font-bold text-secondary font-mono overflow-hidden`}
>
	{
		vals.map((y) => (
			<div class="border-secondary flex aspect-square items-center justify-center border-2 text-[clamp(0.5rem,2vw,1rem)]">
				{letter}
				<sub>{y}</sub>
			</div>
		))
	}
</div>
