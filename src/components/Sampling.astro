---
import Image from './Image.astro'
import Arrow from './shapes/Arrow.astro'
import PlusIcon from './svgs/PlusIcon.astro'

interface Props {
	src: string
	name: string
}

const { src, name } = Astro.props
---

<div class="flex flex-col gap-4">
	<div
		class="border-secondary bg-primary text-secondary w-fit rounded-xl border-4 px-4 py-2 font-mono text-2xl font-bold"
	>
		{name}
	</div>
	<div class="flex flex-row items-center gap-2">
		<Image class="bg-gray-500" src={`/${src}-y.png`} />
		<PlusIcon class="h-16 w-16" />
		<Image class="from-cb-blue to-cb-green bg-gradient-to-br" src={`/${src}-cb.png`} />
		<PlusIcon class="h-16 w-16" />
		<Image class="from-cr-red to-cr-green bg-gradient-to-br" src={`/${src}-cr.png`} />
		<Arrow class="mx-12 -rotate-90" />
		<Image class="bg-secondary" src={`/${src}-rgb.png`} />
	</div>
</div>
