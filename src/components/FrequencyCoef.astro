---
import CosineIcon from './svgs/CosineIcon.astro'

interface Props {
	frequency: number
}

const { frequency } = Astro.props
---

<p class="text-secondary font-mono text-5xl font-bold">
	X<sub>{frequency}</sub>
</p>
<div class="border-secondary relative rounded-xl border-8">
	<p
		class="text-secondary absolute flex h-full w-full items-center justify-center font-mono text-6xl font-bold"
	>
		C<sub>{frequency}</sub>
	</p>
	<CosineIcon frequency={frequency} class="h-32 w-32" viewBox={[100, 100]} />
</div>
