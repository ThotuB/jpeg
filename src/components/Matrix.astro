---
interface Props {
	letter: string
	vals: number[]
}

const { letter, vals } = Astro.props
---

<div
	class={`grid grid-cols-8 border-2 border-secondary rounded-2xl text-4xl font-bold text-secondary font-mono overflow-hidden`}
>
	{
		vals.map((i) => (
			<>
				{vals.map((j) => (
					<div class="border-secondary flex h-16 w-16 items-center justify-center border-2">
						{letter}
						<sub>{`${i}${j}`}</sub>
					</div>
				))}
			</>
		))
	}
</div>
