---
interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<div class={`${className} w-1 h-12 flex flex-col`}>
	<div class="bg-secondary flex-1 rotate-6"></div>
	<div class="bg-secondary relative flex-1 rotate-6"></div>
	<div class="relative">
		<div class="bg-secondary absolute -top-3 -right-0.5 h-3 w-1 rotate-[30deg]"></div>
		<div class="bg-secondary absolute -top-3 -left-1 h-3 w-1 -rotate-[30deg]"></div>
	</div>
</div>
