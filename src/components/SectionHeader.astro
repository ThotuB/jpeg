---
interface Props {
	title: string
	class?: string
	children?: any
}

const { title, class: className = '' } = Astro.props

const kebabCaseTitle = title
	.replace(/[^\w\s]/g, '')
	.replace(/([a-z])([A-Z])/g, '$1-$2')
	.replace(/\s+/g, '-')
	.toLowerCase()
---

<div data-section id={kebabCaseTitle} class="flex flex-row py-4">
	<div class="max-xs:hidden relative flex-1">
		<div class={`absolute max-xl:hidden w-full flex flex-row ${className}`}>
			<slot />
		</div>
	</div>
	<div class="flex h-min flex-1 flex-row">
		<div class="bg-secondary -mr-1 flex -rotate-2 -skew-x-2 flex-col justify-center">
			<h2 class="text-primary max-xs:text-lg px-4 py-2 text-xl font-black">
				{title}
			</h2>
		</div>
		<div class="bg-secondary -mr-px flex-1 rotate-2 skew-x-2"></div>
	</div>
</div>
