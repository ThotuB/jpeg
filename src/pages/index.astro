---
import Footer from 'components/header-footer/Footer.astro'
import Header from 'components/header-footer/Header.astro'
import Main from 'components/Main.astro'
import Modal from '../layouts/Modal.astro'
import RetroCircle from '../layouts/RetroCircle.astro'
import 'styles/global.css'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=yes" />
		<meta name="description" content="" />
		<meta name="author" content="" />
		<title>JPEG Compression</title>

		<link rel="icon" type="image/x-icon" href="favicon.svg" />
	</head>
	<body
		data-theme="pink-purple"
		class="scrollbar font-bit bg-primary relative max-h-screen overflow-hidden"
	>
		<Modal id="modal-img">
			<RetroCircle>
				<img class="pixelated h-full rounded-xl select-none" src="anime.png" alt="anime" />
			</RetroCircle>
		</Modal>
		<div class="scrollbar max-h-screen overflow-x-hidden">
			<Header />
			<Main />
			<Footer />
		</div>
	</body>

	<script>
		const scrollToWindowHash = () => {
			const hash = window.location.hash

			if (!hash) {
				return
			}

			const section = document.querySelector(hash)

			if (section) {
				section.scrollIntoView({ behavior: 'smooth', block: 'start' })
			}
		}

		scrollToWindowHash()
	</script>
</html>
